# Database
DATABASE_URL=
DIRECT_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=

# Server
PORT=3001

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Supabase Storage (policy PDFs)
# Project Settings → API → Project URL + service_role key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Create a private Storage bucket named "policies" in the Supabase dashboard
# if the API cannot create it automatically on boot.
