generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum RoleDefinitionType {
  SYSTEM
  CUSTOM
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum PolicyStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

enum PolicyDocumentType {
  POLICY
  GUIDELINE
  PROCEDURE
}

enum PolicyAnalysisStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum PolicyAnalysisProvider {
  OPENAI
  LOCAL_FALLBACK
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum AssessmentDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AssessmentQuestionSource {
  MANUAL
  AI_GENERATED
}

enum LocationStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  username    String     @unique
  password    String
  firstName   String
  lastName    String
  preferredName        String?
  phone               String?
  employeeId          String?    @unique
  department  String
  departmentId        String?
  locationId          String?
  jobTitle            String?
  reportsToUserId     String?
  dateHired           DateTime?
  role                Role       @default(EMPLOYEE)
  roleTitle           String
  status              UserStatus @default(ACTIVE)
  mustChangePassword  Boolean    @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  departmentRef       Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  locationRef         Location?   @relation("UserLocation", fields: [locationId], references: [id], onDelete: SetNull)
  reportsTo           User?       @relation("UserReportsTo", fields: [reportsToUserId], references: [id], onDelete: SetNull)
  directReports       User[]      @relation("UserReportsTo")
  managedLocations    Location[]  @relation("LocationManager")
  headedDepartments   Department[] @relation("DepartmentHead")
  certificates        Certificate[]
  testResults         TestResult[]
  readingProgress     PolicyReadingProgress[]
}

model Location {
  id            String         @id @default(uuid())
  name          String
  code          String         @unique
  streetAddress String         @default("")
  city          String         @default("")
  province      String         @default("")
  postalCode    String         @default("")
  email         String         @default("")
  phone         String         @default("")
  description   String         @default("")
  status        LocationStatus @default(ACTIVE)
  managerUserId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  manager     User?        @relation("LocationManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  departments Department[]
  users       User[]       @relation("UserLocation")
}

model Department {
  id                  String           @id @default(uuid())
  name                String
  code                String           @unique
  description         String           @default("")
  status              DepartmentStatus @default(ACTIVE)
  establishedDate     DateTime?
  displayOrder        Int              @default(1)
  costCenter          String?
  parentDepartmentId  String?
  headUserId          String?
  locationId          String?
  isOrganizationWide  Boolean          @default(true)
  autoAssignMandatory Boolean          @default(true)
  enableNotifications Boolean          @default(true)
  inheritAssignments  Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")
  head     User?        @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  users    User[]       @relation("UserDepartment")
}

model Category {
  id          String         @id @default(uuid())
  name        String
  code        String         @unique
  description String?
  color       String         @default("#2563EB")
  status      CategoryStatus @default(ACTIVE)
  parentId    String?
  createdBy   String
  updatedBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  policies Policy[]
}

model RoleDefinition {
  id          String                 @id @default(uuid())
  name        String                 @unique
  code        String                 @unique
  description String?
  type        RoleDefinitionType     @default(CUSTOM)
  createdBy   String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  permissions RoleModulePermission[]
}

model RoleModulePermission {
  id         String         @id @default(uuid())
  roleId     String
  moduleKey  String
  canView    Boolean?
  canCreate  Boolean?
  canEdit    Boolean?
  canDelete  Boolean?
  canApprove Boolean?
  canPublish Boolean?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  role RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleKey])
}

model Policy {
  id                  String                 @id @default(uuid())
  title               String
  description         String?
  fileName            String
  filePath            String                 @unique // Path to uploaded file
  fileType            String                 // e.g., "application/pdf"
  department          String
  type                PolicyDocumentType     @default(POLICY)
  status              PolicyStatus           @default(DRAFT)
  content             String?                // Extracted text from file for AI Q&A
  analysisStatus      PolicyAnalysisStatus   @default(NOT_STARTED)
  analysisProvider    PolicyAnalysisProvider?
  analysisModel       String?
  analysisError       String?
  analysisRequestedAt DateTime?
  analysisCompletedAt DateTime?
  summaryShort        String?
  summaryLong         String?
  keyPoints           Json?
  suggestedQuestions  Json?
  version             Int                    @default(1)
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  createdBy           String
  categoryId          String?

  // Relations
  category         Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assessment       Assessment?
  testResults      TestResult[]
  certificates     Certificate[]
  readingProgress  PolicyReadingProgress[]
}

/// Per-user reading progress for a policy (Continue Reading + reader unlock).
model PolicyReadingProgress {
  id                 String    @id @default(uuid())
  userId             String
  policyId           String
  progressPercent    Int       @default(0)
  pagesViewed        Int       @default(0)
  scrollDepthPercent Int       @default(0)
  timeSpentSeconds   Int       @default(0)
  lastAccessedAt     DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([userId, policyId])
  @@index([userId, lastAccessedAt])
}

/// The acknowledgement assessment attached to a policy. One per policy.
model Assessment {
  id           String           @id @default(uuid())
  policyId     String           @unique
  title        String
  description  String?
  instructions String?
  status       AssessmentStatus @default(DRAFT)

  passingScore     Int @default(80)
  /// 0 means unlimited attempts.
  maximumAttempts  Int @default(0)
  /// 0 means no time limit.
  timeLimitMinutes Int @default(20)
  retakeWaitHours  Int @default(0)

  randomizeQuestions         Boolean @default(true)
  shuffleAnswerChoices       Boolean @default(true)
  showExplanationAfterAnswer Boolean @default(true)
  allowReviewAfterSubmission Boolean @default(true)
  showScoreImmediately       Boolean @default(true)
  requirePassToAcknowledge   Boolean @default(true)
  issueCertificateOnPass     Boolean @default(true)
  notifyOnFailure            Boolean @default(false)

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policy    Policy               @relation(fields: [policyId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]
}

model AssessmentQuestion {
  id           String                   @id @default(uuid())
  assessmentId String
  type         AssessmentQuestionType   @default(MULTIPLE_CHOICE)
  prompt       String
  explanation  String?
  points       Int                      @default(1)
  difficulty   AssessmentDifficulty     @default(MEDIUM)
  source       AssessmentQuestionSource @default(MANUAL)
  order        Int
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  assessment Assessment                 @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    AssessmentQuestionOption[]

  @@index([assessmentId, order])
}

model AssessmentQuestionOption {
  id         String  @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, order])
}

model TestResult {
  id         String   @id @default(uuid())
  userId     String
  policyId   String
  score      Int      // Number of correct answers
  totalQuestions Int
  passed     Boolean
  submittedAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String
  policyId  String
  issuedAt  DateTime @default(now())
  certificateNumber String @unique

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
}
