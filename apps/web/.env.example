# Local development (copy to .env.local):
#   cp .env.example .env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Vercel production:
# Project Settings → Environment Variables → Production
# Set to your Railway public URL (no trailing slash), e.g.:
#   NEXT_PUBLIC_API_BASE_URL=https://hinora-production.up.railway.app
# Then Redeploy (required — NEXT_PUBLIC_* is baked in at build time).
#
# NEXT_PUBLIC_API_URL is also accepted as an alias.
